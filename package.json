{
  "name": "onlybudget",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/copy-pdf-worker.js && expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "build:privacy": "node scripts/build-privacy.js",
    "rename": "node scripts/rename-app.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:web": "node scripts/copy-pdf-worker.js && expo export --platform web --output-dir dist && node scripts/postbuild-web.js dist",
    "check:web-security": "node scripts/web-security-check.mjs dist",
    "ui:shots": "node scripts/ui-screenshots.mjs dist out/shots",
    "ui:walkthrough": "node scripts/ui-walkthrough.mjs dist out/walk",
    "ui:scenario": "node scripts/ui-scenario-shots.mjs dist out/scenario",
    "ui:persona": "node scripts/ui-persona-shots.mjs dist out/persona",
    "ui:sweep": "node scripts/ui-sweep-shots.mjs dist out/sweep",
    "ui:gallery": "node scripts/ui-gallery.mjs dist out/gallery",
    "store:shots": "node scripts/store-shots.mjs dist out/store",
    "audit": "npm audit --omit=dev",
    "postinstall": "node scripts/build-pdf-extractor.js",
    "check:pdf-security": "node --experimental-strip-types --no-warnings scripts/pdf-security-check.mjs",
    "check:pdf-extractor": "node scripts/check-pdf-extractor.mjs",
    "audit:shipped": "node scripts/audit-shipped.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^6.3.0",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component"
  }
}
